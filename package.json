{
  "name": "claude-terminal",
  "version": "0.6.8",
  "description": "适配 Claude Code 的多窗口管理终端",
  "private": true,
  "type": "commonjs",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "smoke:pty": "node scripts/smoke-pty.js",
    "smoke:electron": "electron scripts/electron-smoke.js",
    "icon": "pwsh -NoProfile -File scripts/generate-icon.ps1",
    "dist": "electron-vite build && electron-builder",
    "dist:nsis": "electron-vite build && electron-builder --win nsis",
    "dist:zip": "electron-vite build && electron-builder --win zip",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:mac:dir": "electron-vite build && electron-builder --mac --dir"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "pinyin-pro": "^3.28.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "^1.2.0-beta.12",
    "@lydell/node-pty-darwin-x64": "^1.2.0-beta.12",
    "@lydell/node-pty-win32-x64": "^1.2.0-beta.12"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  }
}
